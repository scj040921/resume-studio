<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ResumeStudio</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed Condition="'$(LightweightPublish)' != 'true'">false</PublishTrimmed>
    <PublishTrimmed Condition="'$(LightweightPublish)' == 'true'">true</PublishTrimmed>
    <TrimMode Condition="'$(LightweightPublish)' == 'true'">partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(LightweightPublish)' == 'true'">true</JsonSerializerIsReflectionEnabledByDefault>
    <BuiltInComInteropSupport Condition="'$(LightweightPublish)' == 'true'">true</BuiltInComInteropSupport>
    <Version>0.9.12</Version>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppLogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\UpdatePublicKey.pem" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\ReleaseIdentity.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\ReleaseIdentity.json')" />
    <Content Include="Assets\Templates\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\*.pdf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\*.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\TemplateCatalog.json" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <!-- Reference only the WinUI stack; the umbrella package also ships unused AI/ML and Widgets runtimes. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260224000" />
    <!-- Resource-only source for the notification runtime satellite; build.ps1
         extracts one DLL without adding the umbrella runtime's other payloads. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="1.8.260317003" ExcludeAssets="all" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
  <!-- Preserve the complete application (including JSON models / XAML bindings) and native interop.
       Only unused framework code is removed. Do not switch to full trimming or AOT here. -->
  <ItemGroup Condition="'$(LightweightPublish)' == 'true'">
    <TrimmerRootAssembly Include="ResumeStudio" />
    <TrimmerRootAssembly Include="WinRT.Runtime" />
    <TrimmerRootAssembly Include="Microsoft.WinUI" />
    <TrimmerRootAssembly Include="Microsoft.Web.WebView2.Core.Projection" />
    <TrimmerRootAssembly Include="System.Text.Json" />
    <TrimmerRootAssembly Include="UglyToad.PdfPig" />
  </ItemGroup>
</Project>
